# --- App ---
APP_NAME=NetGuard AI
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
API_V1_PREFIX=/api/v1

# --- Database ---
POSTGRES_USER=netguard
POSTGRES_PASSWORD=netguard
POSTGRES_DB=netguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://netguard:netguard@localhost:5432/netguard

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# --- Notifications (optional) ---
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
# --- GNS3 Lab Integration ---
# Point at an already-running GNS3 controller (local gns3server or GNS3 VM).
# NetGuard never starts/manages GNS3 itself; set GNS3_ENABLED=true to surface /api/v1/gns3.
GNS3_ENABLED=true
GNS3_BASE_URL=http://172.17.1.8:80
GNS3_USERNAME=
GNS3_PASSWORD=
GNS3_REQUEST_TIMEOUT_SECONDS=10
GNS3_CONSOLE_READY_TIMEOUT_SECONDS=45

RISK_ENGINE_BACKEND=llm